{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "sterling",
      "extra-files": [
        "README.md",
        {
          "type": "json",
          "path": "agent-plugins/sterling/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "agent-plugins/sterling/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "agent-plugins/sterling/.codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        "agent-plugins/sterling/skills/adopt-sterling/SKILL.md",
        "agent-plugins/sterling/skills/fix-sterling-findings/SKILL.md",
        "agent-plugins/sterling/skills/sterling-conventions/SKILL.md",
        "agent-plugins/sterling/skills/upgrade-sterling/SKILL.md"
      ]
    }
  }
}
