<?xml version="1.0" encoding="UTF-8"?>
<!-- Sterling's default SpotBugs exclusions, merged with the project's own excludeFilter. -->
<FindBugsFilter>
  <!-- Storing or returning a mutable field: Spring constructor injection and records do it everywhere. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Throwing from a constructor only matters for finalizer attacks; modern Java code has no finalizers. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
</FindBugsFilter>
